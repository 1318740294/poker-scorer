.dbg-banner {
  position: sticky;
  top: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  background: #ffe600;
  color: #1a1400;
  border-bottom: 4rpx solid #ff3b30;
}

.dbg-text {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.dbg-warn {
  font-size: 22rpx;
  font-weight: 600;
  color: #b00020;
}
