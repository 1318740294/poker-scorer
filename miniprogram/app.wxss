page {
  --felt: #0f2e1f;
  --felt-deep: #0b1a12;
  --felt-edge: #1a4a32;
  --rail: #5c3a1e;
  --chip-gold: #d4a017;
  --ink: #f2efe6;
  --muted: #a8b5a0;
  --danger: #c45c4a;
  --accent: #e8c547;
  --seat-bg: rgba(8, 22, 14, 0.72);
  --font-display: "Songti SC", "Noto Serif SC", "STSong", serif;
  --font-ui: "PingFang SC", "HarmonyOS Sans", "Helvetica Neue", sans-serif;

  min-height: 100%;
  background:
    radial-gradient(ellipse at 50% 30%, #163d28 0%, var(--felt-deep) 55%, #070f0a 100%);
  color: var(--ink);
  font-family: var(--font-ui);
  box-sizing: border-box;
}

view, text, button, input {
  box-sizing: border-box;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 36rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.2;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(180deg, #e8c547, #c9a227);
  color: #1a1408;
  font-weight: 600;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: var(--ink);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.btn-danger {
  background: rgba(196, 92, 74, 0.9);
  color: #fff;
}

.btn[disabled] {
  opacity: 0.4;
}

.field {
  width: 100%;
  padding: 20rpx 24rpx;
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  color: var(--ink);
  font-size: 28rpx;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}
