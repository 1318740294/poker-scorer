.page {
  min-height: 100vh;
  padding-bottom: 280rpx;
}

.topbar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  align-items: center;
}

.code {
  font-family: var(--font-display);
  color: var(--accent);
  letter-spacing: 2rpx;
}

.tb {
  font-size: 22rpx;
  color: var(--muted);
}

.felt-wrap {
  position: relative;
  width: 100%;
  height: 720rpx;
  margin-top: 8rpx;
}

.rail {
  position: absolute;
  left: 6%;
  right: 6%;
  top: 8%;
  bottom: 12%;
  border-radius: 50%;
  background: linear-gradient(160deg, #7a4a24, #4a2a12 45%, #3a200e);
  box-shadow:
    inset 0 0 0 10rpx rgba(0, 0, 0, 0.25),
    0 20rpx 40rpx rgba(0, 0, 0, 0.45);
  padding: 18rpx;
}

.felt {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background:
    radial-gradient(ellipse at 50% 40%, #1f5a3a 0%, #0f2e1f 55%, #0a1f14 100%);
  border: 2rpx solid rgba(232, 197, 71, 0.18);
  position: relative;
}

.pot-center {
  position: absolute;
  left: 50%;
  top: 46%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.pot-label {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: var(--muted);
}

.pot-val {
  font-family: var(--font-display);
  font-size: 48rpx;
  color: var(--accent);
  margin-top: 4rpx;
}

.street {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink);
  opacity: 0.85;
}

.chips-visual {
  position: relative;
  height: 36rpx;
  margin-top: 12rpx;
}

.chip {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(255, 255, 255, 0.55);
  left: 50%;
}

.chip.c1 {
  background: #c45c4a;
  transform: translateX(-30rpx);
}
.chip.c2 {
  background: #2f6fed;
  transform: translateX(-6rpx);
  top: 4rpx;
}
.chip.c3 {
  background: #d4a017;
  transform: translateX(18rpx);
}

.player {
  position: absolute;
  width: 160rpx;
  transform: translate(-50%, -50%);
  z-index: 2;
  transition: opacity 0.25s ease;
}

.player.folded {
  opacity: 0.35;
}

.player.action .p-avatar {
  box-shadow: 0 0 0 4rpx var(--accent);
}

.p-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  position: relative;
}

.ring {
  position: absolute;
  inset: -8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--accent);
  animation: pulse 1.2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.35; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

.p-info {
  margin-top: 6rpx;
  text-align: center;
  background: var(--seat-bg);
  border-radius: 12rpx;
  padding: 6rpx 8rpx;
}

.p-name {
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.p-stack {
  font-size: 22rpx;
  color: var(--accent);
}

.p-bet {
  font-size: 18rpx;
  color: #9ad0ff;
}

.p-tag {
  display: inline-block;
  margin-top: 4rpx;
  font-size: 16rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(232, 197, 71, 0.2);
  color: var(--accent);
}

.p-tag.sb, .p-tag.bb {
  background: rgba(255, 255, 255, 0.1);
  color: var(--ink);
}

.p-tag.allin {
  background: rgba(196, 92, 74, 0.35);
  color: #ffb4a8;
}

.countdown {
  margin-top: 4rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.showdown {
  margin: 16rpx 24rpx;
  padding: 20rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 16rpx;
}

.sd-title {
  font-family: var(--font-display);
  margin-bottom: 12rpx;
}

.sd-pot {
  margin-bottom: 16rpx;
}

.sd-line {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.sd-winners {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.pick {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.08);
  font-size: 22rpx;
}

.pick.on {
  background: var(--accent);
  color: #1a1408;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 88rpx;
  padding: 16rpx 20rpx calc(8rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent, rgba(7, 15, 10, 0.96) 20%);
  z-index: 10;
}

.timer-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.moves {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.move {
  flex: 1;
  padding: 16rpx 8rpx;
  font-size: 24rpx;
}

.shortcuts {
  display: flex;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 8rpx;
}

.mini {
  height: 56rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  line-height: 56rpx;
  font-size: 22rpx;
}

.mini-input {
  width: 100rpx;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0 8rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  text-align: center;
}

.hint {
  font-size: 20rpx;
}

.host-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 48rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: center;
  padding: 0 16rpx;
  z-index: 9;
  pointer-events: none;
}

.host-bar .btn {
  pointer-events: auto;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 8rpx 20rpx calc(8rpx + env(safe-area-inset-bottom));
  background: rgba(7, 15, 10, 0.95);
  z-index: 11;
}

.bottom-nav .btn {
  flex: 1;
}

/* when action bar visible, host bar sits above it — tweak via page class if needed */
.page .host-bar {
  bottom: auto;
  top: 88rpx;
  justify-content: flex-end;
  padding-right: 20rpx;
}
