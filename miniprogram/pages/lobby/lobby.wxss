.page {
  padding: 32rpx 28rpx 120rpx;
}

.header {
  margin-bottom: 28rpx;
}

.code-wrap {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.code {
  font-family: var(--font-display);
  font-size: 56rpx;
  letter-spacing: 8rpx;
  color: var(--accent);
}

.meta {
  margin-top: 8rpx;
}

.seat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.seat {
  position: relative;
  padding: 20rpx 12rpx;
  background: rgba(0, 0, 0, 0.22);
  border-radius: 16rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.seat.me {
  border-color: var(--accent);
}

.seat.empty {
  opacity: 0.75;
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto 10rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.name {
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stack {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.host-tag {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 18rpx;
  color: var(--accent);
}

.panel {
  margin-top: 28rpx;
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16rpx;
}

.label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sm {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.slash {
  color: var(--muted);
}

.sm-btn {
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  line-height: 72rpx;
  flex-shrink: 0;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, transparent, rgba(7, 15, 10, 0.95) 30%);
}

.footer .btn {
  flex: 1;
}
