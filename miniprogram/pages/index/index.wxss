.page {
  padding: 48rpx 40rpx 80rpx;
  min-height: 100vh;
}

.hero {
  padding: 48rpx 8rpx 56rpx;
}

.brand {
  font-family: var(--font-display);
  font-size: 72rpx;
  letter-spacing: 4rpx;
  color: var(--accent);
  text-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

.tagline {
  margin-top: 16rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.panel {
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

.label {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.persona-row {
  white-space: nowrap;
  margin-top: 8rpx;
}

.persona {
  display: inline-flex;
  width: 88rpx;
  height: 88rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  opacity: 0.55;
  border: 3rpx solid transparent;
}

.persona.on {
  opacity: 1;
  border-color: var(--accent);
  transform: scale(1.06);
}

.actions {
  margin-top: 48rpx;
}

.block {
  width: 100%;
  margin-bottom: 24rpx;
}

.join-row {
  display: flex;
  gap: 16rpx;
  align-items: stretch;
}

.join-row .field,
.join-row .btn {
  height: 80rpx;
  min-height: 80rpx;
  line-height: 80rpx;
}

.code {
  flex: 1;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.debug-panel {
  margin-top: 40rpx;
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.28);
  border: 1rpx dashed rgba(232, 197, 71, 0.35);
  border-radius: 16rpx;
}

.debug-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.debug-title {
  font-size: 24rpx;
  color: var(--accent);
}

.debug-toggle {
  padding: 0 20rpx;
  height: 56rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
}

.debug-body {
  margin-top: 16rpx;
}

.debug-ids {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.debug-chip {
  padding: 0 20rpx;
  height: 56rpx;
  min-height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 12rpx;
}

.debug-chip.on {
  color: #1a1408;
  background: var(--accent);
  border-color: var(--accent);
}

.hint {
  margin-top: 48rpx;
  text-align: center;
  line-height: 1.6;
}
