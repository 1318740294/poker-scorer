<view class="page">
  <debug-banner id="dbgBanner" />

  <view class="hero">
    <view class="brand">德州记分桌</view>
    <view class="tagline">现金局共享桌 · 无牌面纯记分</view>
  </view>

  <view class="panel">
    <view class="label">你的昵称</view>
    <input class="field" placeholder="怎么称呼你" value="{{nickname}}" bindinput="onNick" maxlength="12" />

    <view class="label" style="margin-top: 28rpx;">形象</view>
    <scroll-view scroll-x class="persona-row">
      <view
        wx:for="{{personas}}"
        wx:key="*this"
        class="persona {{persona === item ? 'on' : ''}}"
        style="background: {{colors[item]}};"
        data-id="{{item}}"
        bindtap="onPersona"
      >{{labels[item]}}</view>
    </scroll-view>
  </view>

  <view class="actions">
    <button class="btn btn-primary block" loading="{{busy}}" bindtap="onCreate">创建房间</button>
    <view class="join-row">
      <input class="field code" placeholder="输入 6 位房号" value="{{code}}" bindinput="onCode" maxlength="6" />
      <button class="btn btn-ghost" loading="{{busy}}" bindtap="onJoin">加入</button>
    </view>
  </view>

  <view class="debug-panel" wx:if="{{showDebug}}">
    <view class="debug-head">
      <text class="debug-title">调试 · 单人多身份</text>
      <button class="btn btn-ghost debug-toggle" bindtap="toggleDebug">{{debugOn ? '关闭' : '开启'}}</button>
    </view>
    <view class="debug-body" wx:if="{{debugOn}}">
      <view class="muted">开启后顶栏必须是「调试身份: dbg_host」（或 dbg_p2）。绝不能是真实 openId。推荐「本机双人自测」；或手动：Host 建房 → 回首页切玩家2 → 同房号加入占空位。</view>
      <view class="debug-ids">
        <view
          wx:for="{{debugIds}}"
          wx:key="id"
          class="debug-chip {{debugOpenId === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPickDebugId"
        >{{item.label}}</view>
      </view>
      <button
        class="btn btn-primary block dual-btn"
        loading="{{busy}}"
        bindtap="onDualSelfTest"
      >本机双人自测</button>
      <view class="mismatch" wx:if="{{mismatchText}}">{{mismatchText}}</view>
    </view>
  </view>

  <view class="hint muted">
    5–12 人 · 自动盲注 · 边池自动拆 · 房主点赢家
  </view>
</view>
